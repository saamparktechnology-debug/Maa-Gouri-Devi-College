<%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0">Salary Management</h4>

            <!-- Year Selector -->
            <form action="/admin/salaries" method="GET" class="d-flex align-items-center">
                <label class="me-2 fw-bold text-secondary">Year:</label>
                <select name="year" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                    <option value="2025" <%=selectedYear==2025 ? 'selected' : '' %>>2025</option>
                    <option value="2026" <%=selectedYear==2026 ? 'selected' : '' %>>2026</option>
                    <option value="2027" <%=selectedYear==2027 ? 'selected' : '' %>>2027</option>
                </select>
            </form>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0 text-center"
                        style="min-width: 1200px;">
                        <thead class="table-light">
                            <tr>
                                <th class="text-start" style="width: 250px;">Teacher</th>
                                <th>Base (₹)</th>
                                <% months.forEach(m=> { %> <th>
                                        <%= m.short %>
                                    </th>
                                    <% }) %>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(teachers.length===0) { %>
                                <tr>
                                    <td colspan="14" class="text-muted py-4">No active teachers found.</td>
                                </tr>
                                <% } %>

                                    <% teachers.forEach(t=> { %>
                                        <tr>
                                            <td class="text-start fw-bold">
                                                <%= t.name %>
                                                    <br>
                                                    <small class="text-muted fw-normal">
                                                        <%= t.emp_id %>
                                                    </small>
                                            </td>
                                            <td class="fw-bold text-primary">
                                                <%= t.salary_package %>
                                            </td>

                                            <% months.forEach(m=> {
                                                // Find if this teacher has a payment record for this specific month
                                                const payment = t.SalaryPayments.find(p => p.month === m.val);
                                                %>
                                                <td>
                                                    <% if (payment && payment.status==='Paid' ) { %>
                                                        <div class="text-success small fw-bold"><i
                                                                class="bi bi-check-circle-fill"></i> Paid</div>
                                                        <div class="text-muted" style="font-size: 0.7rem;">
                                                            <%= payment.payment_date %>
                                                        </div>
                                                        <% } else { %>
                                                            <% // Calculate due amount if partially paid let
                                                                due=t.salary_package; if (payment)
                                                                due=parseFloat(t.salary_package) -
                                                                parseFloat(payment.paid_amount); %>
                                                                <button
                                                                    class="btn btn-sm <%= payment ? 'btn-warning' : 'btn-outline-primary' %>"
                                                                    style="font-size: 0.75rem;"
                                                                    onclick="openSalaryModal('<%= t.id %>', '<%= t.first_name %> <%= t.last_name %>', '<%= m.val %>', '<%= m.short %>', '<%= t.salary_package %>', '<%= due %>')">
                                                                    <%= payment ? 'Partial' : 'Pay' %>
                                                                </button>
                                                                <% } %>
                                                </td>
                                                <% }) %>
                                        </tr>
                                        <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SINGLE DYNAMIC PAYMENT MODAL -->
        <div class="modal fade" id="salaryModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form action="/admin/salaries/pay" method="POST">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalTitle">Process Salary</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="teacher_id" id="m_teacher_id">
                            <input type="hidden" name="month" id="m_month">
                            <input type="hidden" name="year" value="<%= selectedYear %>">
                            <input type="hidden" name="salary_amount" id="m_salary_amount">

                            <div class="mb-3">
                                <label class="form-label text-muted">Amount Due for this Month</label>
                                <input type="text" id="m_due_display" class="form-control fw-bold text-danger" readonly>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Paying Amount (₹) *</label>
                                <input type="number" step="0.01" name="paid_amount" id="m_paid_amount"
                                    class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Payment Date *</label>
                                <input type="date" name="payment_date" class="form-control" required id="todayDate">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Reference No. (Bank/Cheque/UPI)</label>
                                <input type="text" name="payment_reference" class="form-control">
                            </div>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="submit" class="btn btn-primary">Record Payment</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            // Set today's date in the date picker automatically
            document.getElementById('todayDate').valueAsDate = new Date();

            // Dynamically populate the modal when a Pay button is clicked
            function openSalaryModal(t_id, t_name, month_val, month_name, total_salary, due_amount) {
                document.getElementById('m_teacher_id').value = t_id;
                document.getElementById('m_month').value = month_val;
                document.getElementById('m_salary_amount').value = total_salary;

                document.getElementById('m_due_display').value = '₹ ' + parseFloat(due_amount).toFixed(2);

                // Default the input to the full due amount for convenience
                document.getElementById('m_paid_amount').value = parseFloat(due_amount).toFixed(2);
                document.getElementById('m_paid_amount').max = due_amount;

                document.getElementById('modalTitle').innerText = `Pay Salary: ${t_name} - ${month_name} <%= selectedYear %>`;

                // Show Bootstrap Modal
                var myModal = new bootstrap.Modal(document.getElementById('salaryModal'));
                myModal.show();
            }
        </script>

        <%- include('../partials/footer') %>