<%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0">Monthly Attendance Matrix</h4>
        </div>

        <!-- Filter Form -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <form action="/admin/attendance/monthly" method="GET" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Session</label>
                        <select name="session_id" class="form-select" required>
                            <option value="">Select...</option>
                            <% sessions.forEach(s=> { %>
                                <option value="<%= s.id %>" <%=(typeof selectedSession !=='undefined' &&
                                    selectedSession==s.id) ? 'selected' : '' %>><%= s.session_name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Course</label>
                        <select name="course_id" id="courseSelect" class="form-select" required
                            onchange="filterSemesters()">
                            <option value="">Select...</option>
                            <% courses.forEach(c=> { %>
                                <option value="<%= c.id %>" <%=(typeof selectedCourse !=='undefined' &&
                                    selectedCourse==c.id) ? 'selected' : '' %>><%= c.course_name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Semester</label>
                        <select name="semester_id" id="semesterSelect" class="form-select" required>
                            <option value="">Select...</option>
                            <% semesters.forEach(sem=> { %>
                                <option value="<%= sem.id %>" data-course="<%= sem.course_id %>" <%=(typeof
                                    selectedSemester !=='undefined' && selectedSemester==sem.id) ? 'selected' : '' %>>
                                    <%= sem.semester_name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Month</label>
                        <input type="month" name="month" class="form-control"
                            value="<%= typeof month !== 'undefined' ? month : '' %>" required>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-table"></i> Generate
                            Matrix</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Report Table -->
        <% if (typeof reportData !=='undefined' ) { %>
            <div class="card border-0 shadow-sm" id="printableArea">
                <div
                    class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2 py-3">
                    <div>
                        <h6 class="mb-0 text-primary fw-bold" id="reportTitle">Daily Attendance Record - <%= month %>
                        </h6>
                        <small class="text-muted" id="reportMeta">Course: <%= courses.find(c=> c.id ==
                                selectedCourse)?.course_name || 'N/A' %> | Semester: <%= semesters.find(s=> s.id ==
                                    selectedSemester)?.semester_name || 'N/A' %> | Session: <%= sessions.find(s=> s.id
                                        == selectedSession)?.session_name || 'N/A' %></small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <input type="text" id="searchInput" class="form-control form-control-sm"
                            placeholder="🔍 Find Student..." style="width: 180px;">
                        <div class="btn-group">
                            <button type="button" class="btn btn-outline-success btn-sm dropdown-toggle"
                                data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-download me-1"></i> Export
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li><a class="dropdown-item" href="#" onclick="exportExcel()"><i
                                            class="bi bi-file-earmark-excel text-success me-2"></i> Export Excel
                                        (.xlsx)</a></li>
                                <li><a class="dropdown-item" href="#" onclick="exportCSV()"><i
                                            class="bi bi-file-text text-primary me-2"></i> Export CSV (.csv)</a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="#" onclick="exportPDF()"><i
                                            class="bi bi-file-earmark-pdf text-danger me-2"></i> Export PDF (.pdf)</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm table-bordered align-middle mb-0 text-center"
                            id="reportTable" style="font-size: 0.85rem;">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-start ps-3" style="min-width: 100px;">Roll/Adm</th>
                                    <th class="text-start" style="min-width: 150px;">Student Name</th>
                                    <% for(let i=1; i <=daysInMonth; i++) { %>
                                        <th style="min-width: 35px;">
                                            <%= i %>
                                        </th>
                                        <% } %>
                                            <th class="text-success" style="min-width: 40px;">P</th>
                                            <th class="text-danger" style="min-width: 40px;">A</th>
                                            <th>%</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (reportData.length===0) { %>
                                    <tr>
                                        <td colspan="<%= daysInMonth + 5 %>" class="text-center py-4 text-muted">No
                                            records found.</td>
                                    </tr>
                                    <% } %>
                                        <% reportData.forEach(s=> { %>
                                            <tr>
                                                <td class="text-start ps-3 fw-bold">
                                                    <%= s.admission_no %>
                                                </td>
                                                <td class="text-start" style="white-space: nowrap;">
                                                    <%= s.name %>
                                                </td>
                                                <% for(let i=1; i <=daysInMonth; i++) { let status=s.dailyStatus[i]
                                                    || '-' ; let textColor='text-muted' ; if(status==='P' )
                                                    textColor='text-success fw-bold' ; else if(status==='A' )
                                                    textColor='text-danger fw-bold' ; else if(status==='L' )
                                                    textColor='text-warning fw-bold' ; %>
                                                    <td class="<%= textColor %>">
                                                        <%= status %>
                                                    </td>
                                                    <% } %>
                                                        <td class="text-success fw-bold bg-light">
                                                            <%= s.present %>
                                                        </td>
                                                        <td class="text-danger fw-bold bg-light">
                                                            <%= s.absent %>
                                                        </td>
                                                        <td class="bg-light">
                                                            <% let badgeColor='bg-danger' ; if (s.percentage>= 75) {
                                                                badgeColor = 'bg-success';
                                                                } else if (s.percentage >= 60) {
                                                                badgeColor = 'bg-warning text-dark';
                                                                }
                                                                %>

                                                                <span class="badge <%= badgeColor %>">
                                                                    <%= s.percentage %>%
                                                                </span>
                                                        </td>
                                            </tr>
                                            <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <% } %>

                <!-- SheetJS (xlsx) for Excel Export -->
                <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
                <!-- jsPDF and AutoTable for PDF Export -->
                <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
                <script
                    src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

                <script>
                    function filterSemesters() {
                        const courseId = document.getElementById('courseSelect').value;
                        const semSelect = document.getElementById('semesterSelect');
                        const options = semSelect.querySelectorAll('option');

                        options.forEach(opt => {
                            if (opt.value === "") {
                                opt.style.display = '';
                                return;
                            }

                            if (opt.getAttribute('data-course') === courseId) {
                                opt.style.display = '';
                            } else {
                                opt.style.display = 'none';

                                if (semSelect.value === opt.value) {
                                    semSelect.value = '';
                                }
                            }
                        });
                    }

                    document.addEventListener("DOMContentLoaded", () => {
                        // Filter semesters on initial page load
                        filterSemesters();

                        const searchInput = document.getElementById("searchInput");

                        if (searchInput) {
                            searchInput.addEventListener("keyup", function () {
                                const query = this.value.toLowerCase().trim();
                                const rows = document.querySelectorAll("#reportTable tbody tr");

                                rows.forEach(row => {
                                    if (row.cells.length < 5) return;

                                    const admText = row.cells[0].innerText.toLowerCase();
                                    const nameText = row.cells[1].innerText.toLowerCase();

                                    row.style.display =
                                        admText.includes(query) || nameText.includes(query)
                                            ? ""
                                            : "none";
                                });
                            });
                        }
                    });


                    function exportExcel() {
                        const table = document.getElementById("reportTable");
                        const wb = XLSX.utils.table_to_book(table, { sheet: "Attendance Matrix" });
                        const monthStr = "<%= typeof month !== 'undefined' ? month : 'Report' %>";
                        XLSX.writeFile(wb, "Attendance_Matrix_" + monthStr + ".xlsx");
                    }

                    function exportCSV() {
                        const table = document.getElementById("reportTable");
                        let csv = [];
                        const rows = table.querySelectorAll("tr");
                        rows.forEach(row => {
                            let cols = row.querySelectorAll("td, th"), data = [];
                            cols.forEach(col => data.push('"' + col.innerText.replace(/"/g, '""') + '"'));
                            csv.push(data.join(","));
                        });
                        const csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
                        const downloadLink = document.createElement("a");
                        const monthStr = "<%= typeof month !== 'undefined' ? month : 'Report' %>";
                        downloadLink.download = "Attendance_Matrix_" + monthStr + ".csv";
                        downloadLink.href = window.URL.createObjectURL(csvFile);
                        downloadLink.style.display = "none";
                        document.body.appendChild(downloadLink);
                        downloadLink.click();
                        document.body.removeChild(downloadLink);
                    }

                    function exportPDF() {
                        const { jsPDF } = window.jspdf;
                        const doc = new jsPDF('landscape', 'pt', 'a4');

                        const collegeName = "MAA GOURI DEVI COLLEGE";
                        const reportTitle = document.getElementById("reportTitle").innerText;
                        const reportMeta = document.getElementById("reportMeta").innerText;

                        doc.setFontSize(16);
                        doc.setTextColor(40, 40, 40);
                        doc.text(collegeName, doc.internal.pageSize.getWidth() / 2, 35, { align: 'center' });

                        doc.setFontSize(11);
                        doc.setTextColor(100, 100, 100);
                        doc.text(reportTitle, doc.internal.pageSize.getWidth() / 2, 55, { align: 'center' });
                        doc.text(reportMeta, doc.internal.pageSize.getWidth() / 2, 72, { align: 'center' });

                        doc.autoTable({
                            html: '#reportTable',
                            startY: 85,
                            theme: 'grid',
                            styles: { fontSize: 7, cellPadding: 2, halign: 'center' },
                            headStyles: { fillColor: [41, 128, 185], textColor: 255 },
                            columnStyles: {
                                0: { halign: 'left' },
                                1: { halign: 'left' }
                            }
                        });

                        const monthStr = "<%= typeof month !== 'undefined' ? month : 'Report' %>";
                        doc.save("Attendance_Matrix_" + monthStr + ".pdf");
                    }
                </script>

                <%- include('../partials/footer') %>