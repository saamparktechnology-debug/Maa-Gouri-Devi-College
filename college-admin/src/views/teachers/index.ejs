<%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0">Teacher Directory</h4>
            <a href="/admin/teachers/create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Teacher</a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Emp ID</th>
                            <th>Name</th>
                            <th>Designation</th>
                            <th>Department</th>
                            <th>Mobile</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(teachers.length===0) { %>
                            <tr>
                                <td colspan="6" class="text-center text-muted">No teachers found.</td>
                            </tr>
                            <% } %>
                                <% teachers.forEach(t=> { %>
                                    <tr>
                                        <td class="fw-bold text-primary">
                                            <%= t.emp_id %>
                                        </td>
                                        <td>
                                            <%= t.name %>
                                        </td>
                                        <td>
                                            <%= t.designation %>
                                        </td>
                                        <td>
                                            <%= t.department %>
                                        </td>
                                        <td>
                                            <%= t.mobile %>
                                        </td>
                                        <td><span
                                                class="badge <%= t.status === 'Active' ? 'bg-success' : 'bg-secondary' %>">
                                                <%= t.status %>
                                            </span></td>
                                    </tr>
                                    <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <%- include('../partials/footer') %>