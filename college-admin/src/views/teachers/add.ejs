<%- include('../partials/header') %>
        <%- include('../partials/sidebar') %>

                <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0">Onboard New Teacher</h4>
                        <a href="/admin/teachers" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i>
                                Back</a>
                </div>

                <form action="/admin/teachers" method="POST" enctype="multipart/form-data">
                        <!-- Professional Details -->
                        <div class="card border-0 shadow-sm mb-4">
                                <div class="card-header bg-white fw-bold text-primary">
                                        <i class="bi bi-briefcase me-2"></i> Professional Details
                                </div>
                                <div class="card-body row">
                                        <div class="col-md-3 mb-3">
                                                <label class="form-label">Employee ID *</label>
                                                <input type="text" name="emp_id" class="form-control" required>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                                <label class="form-label">Joining Date *</label>
                                                <input type="date" name="joining_date" class="form-control" required>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                                <label class="form-label">Designation</label>
                                                <input type="text" name="designation" class="form-control">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                                <label class="form-label">Department</label>
                                                <input type="text" name="department" class="form-control">
                                        </div>
                                        <div class="col-md-4 mb-3">
                                                <label class="form-label">Qualification</label>
                                                <input type="text" name="qualification" class="form-control">
                                        </div>
                                        <div class="col-md-4 mb-3">
                                                <label class="form-label">Employment Type</label>
                                                <select name="employment_type" class="form-select">
                                                        <option>Full-Time</option>
                                                        <option>Part-Time</option>
                                                        <option>Contract</option>
                                                </select>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                                <label class="form-label">Monthly Salary (₹) *</label>
                                                <input type="number" step="0.01" name="salary_package"
                                                        class="form-control" required>
                                        </div>
                                </div>
                        </div>

                        <!-- Personal Details -->
                        <div class="card border-0 shadow-sm mb-4">
                                <div class="card-header bg-white fw-bold text-primary">
                                        <i class="bi bi-person me-2"></i> Personal Details
                                </div>
                                <div class="card-body row">
                                        <div class="col-md-6 mb-3">
                                                <label class="form-label">Name *</label>
                                                <input type="text" name="name" class="form-control" required>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                                <label class="form-label">Date of Birth *</label>
                                                <input type="date" name="dob" class="form-control" required>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                                <label class="form-label">Gender</label>
                                                <select name="gender" class="form-select">
                                                        <option>Male</option>
                                                        <option>Female</option>
                                                </select>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                                <label class="form-label">Mobile</label>
                                                <input type="text" name="mobile" class="form-control">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                                <label class="form-label">Email</label>
                                                <input type="email" name="email" class="form-control">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold">Aadhaar Card Number</label>
                                                <input type="text" name="aadhaar_no" class="form-control"
                                                        placeholder="Enter 12-digit Aadhaar number" maxlength="12">
                                        </div>
                                        <div class="col-md-12 mb-3">
                                                <label class="form-label">Address</label>
                                                <input type="text" name="address" class="form-control">
                                        </div>
                                </div>
                        </div>

                        <!-- Dynamic Unlimited Documents -->
                        <div class="card border-0 shadow-sm mb-4">
                                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-primary"><i class="bi bi-file-earmark me-2"></i>
                                                Documents (JPG, PNG, PDF | Max 5MB)</span>
                                        <button type="button" class="btn btn-sm btn-outline-primary fw-bold"
                                                onclick="addDocumentRow()">
                                                <i class="bi bi-plus-circle"></i> Add More Document +
                                        </button>
                                </div>
                                <div class="card-body">
                                        <div id="documentContainer">
                                                <div class="row document-row mb-3 align-items-end">
                                                        <div class="col-md-5">
                                                                <label class="form-label small text-muted">Document Type
                                                                        / Title</label>
                                                                <input type="text" name="document_types[]"
                                                                        class="form-control"
                                                                        placeholder="e.g., Photograph, ID Proof, Degree">
                                                        </div>
                                                        <div class="col-md-6">
                                                                <label class="form-label small text-muted">Select
                                                                        File</label>
                                                                <input type="file" name="documents" class="form-control"
                                                                        accept=".jpg,.jpeg,.png,.pdf">
                                                        </div>
                                                        <div class="col-md-1 text-end"></div>
                                                </div>
                                        </div>
                                </div>
                        </div>

                        <div class="text-end mb-5">
                                <button type="submit" class="btn btn-primary btn-lg">
                                        <i class="bi bi-check-circle"></i> Save Teacher
                                </button>
                        </div>
                </form>

                <script>
                        function addDocumentRow() {
                                const container = document.getElementById('documentContainer');
                                const row = document.createElement('div');
                                row.className = 'row document-row mb-3 align-items-end';
                                row.innerHTML = `
            <div class="col-md-5">
                <input type="text" name="document_types[]" class="form-control" placeholder="Document Type / Title">
            </div>
            <div class="col-md-6">
                <input type="file" name="documents" class="form-control" accept=".jpg,.jpeg,.png,.pdf">
            </div>
            <div class="col-md-1 text-end">
                <button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="this.closest('.document-row').remove()">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        `;
                                container.appendChild(row);
                        }
                </script>

                <%- include('../partials/footer') %>