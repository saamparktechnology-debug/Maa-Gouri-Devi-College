<%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0">Semester Master</h4>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addSemModal">
                <i class="bi bi-plus-circle"></i> Add Semester
            </button>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">

                <!-- THE UPGRADE: Real-time Filters -->
                <div class="row mb-4">
                    <div class="col-md-4 mb-2">
                        <input type="text" id="searchInput" class="form-control"
                            placeholder="🔍 Search semester name...">
                    </div>
                    <div class="col-md-4 mb-2">
                        <select id="filterCourse" class="form-select">
                            <option value="">All Courses</option>
                            <% courses.forEach(c=> { %>
                                <option value="<%= c.course_name.toLowerCase() %>">
                                    <%= c.course_name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-md-4 mb-2">
                        <select id="filterStatus" class="form-select">
                            <option value="">All Statuses</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="semesterTable">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Course</th>
                                <th>Semester Name</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% semesters.forEach(s=> { %>
                                <tr>
                                    <td>
                                        <%= s.id %>
                                    </td>
                                    <td>
                                        <%= s.Course.course_name %>
                                    </td>
                                    <td class="fw-bold">
                                        <%= s.semester_name %>
                                    </td>
                                    <td>
                                        <span class="badge <%= s.is_active ? 'bg-success' : 'bg-danger' %>">
                                            <%= s.is_active ? 'Active' : 'Inactive' %>
                                        </span>
                                    </td>
                                    <td>
                                        <form action="/admin/semesters/<%= s.id %>/toggle" method="POST"
                                            style="display:inline;">
                                            <button type="submit"
                                                class="btn btn-sm <%= s.is_active ? 'btn-outline-danger' : 'btn-outline-success' %>">
                                                <%= s.is_active ? 'Deactivate' : 'Activate' %>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                                    <!-- Fallback row for empty search results -->
                                    <tr id="noResultsRow" style="display: none;">
                                        <td colspan="5" class="text-center text-muted py-4">No semesters match your
                                            filters.</td>
                                    </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Modal -->
        <div class="modal fade" id="addSemModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form action="/admin/semesters" method="POST">
                        <div class="modal-header">
                            <h5 class="modal-title">New Semester</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Course</label>
                                <select name="course_id" class="form-select" required>
                                    <option value="">Select Course...</option>
                                    <% courses.forEach(c=> { %>
                                        <option value="<%= c.id %>">
                                            <%= c.course_name %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Semester Name (e.g. Semester 1)</label>
                                <input type="text" name="semester_name" class="form-control" required>
                            </div>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="submit" class="btn btn-primary">Save Semester</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Real-Time Filter Script -->
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const searchInput = document.getElementById("searchInput");
                const filterCourse = document.getElementById("filterCourse");
                const filterStatus = document.getElementById("filterStatus");
                const tableRows = document.querySelectorAll("#semesterTable tbody tr:not(#noResultsRow)");
                const noResultsRow = document.getElementById("noResultsRow");

                function filterTable() {
                    const query = searchInput.value.toLowerCase().trim();
                    const course = filterCourse.value.toLowerCase().trim();
                    const status = filterStatus.value.toLowerCase().trim();
                    let visibleCount = 0;

                    tableRows.forEach(row => {
                        const rowText = row.innerText.toLowerCase();

                        // Course is in column index 1, Status is in column index 3
                        const rowCourse = row.cells[1].innerText.toLowerCase().trim();
                        const rowStatus = row.cells[3].innerText.toLowerCase().trim();

                        // Check matches
                        const matchesSearch = query === "" || rowText.includes(query);
                        const matchesCourse = course === "" || rowCourse === course;
                        const matchesStatus = status === "" || rowStatus === status;

                        if (matchesSearch && matchesCourse && matchesStatus) {
                            row.style.display = "";
                            visibleCount++;
                        } else {
                            row.style.display = "none";
                        }
                    });

                    // Show "No Results" message if everything is filtered out
                    noResultsRow.style.display = visibleCount === 0 ? "" : "none";
                }

                // Attach event listeners
                searchInput.addEventListener("keyup", filterTable);
                filterCourse.addEventListener("change", filterTable);
                filterStatus.addEventListener("change", filterTable);
            });
        </script>

        <%- include('../partials/footer') %>