<%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0">Session Master</h4>
            <!-- Button trigger modal -->
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addSessionModal">
                <i class="bi bi-plus-circle"></i> Add New Session
            </button>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Session Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(sessions.length===0) { %>
                            <tr>
                                <td colspan="6" class="text-center text-muted">No sessions found.</td>
                            </tr>
                            <% } %>
                                <% sessions.forEach(s=> { %>
                                    <tr>
                                        <td>
                                            <%= s.id %>
                                        </td>
                                        <td class="fw-bold">
                                            <%= s.session_name %>
                                        </td>
                                        <td>
                                            <%= s.start_date %>
                                        </td>
                                        <td>
                                            <%= s.end_date %>
                                        </td>
                                        <td>
                                            <% if(s.is_active) { %>
                                                <span class="badge bg-success">Active</span>
                                                <% } else { %>
                                                    <span class="badge bg-danger">Inactive</span>
                                                    <% } %>
                                        </td>
                                        <td>
                                            <form action="/admin/sessions/<%= s.id %>/toggle" method="POST"
                                                style="display:inline;">
                                                <button type="submit"
                                                    class="btn btn-sm <%= s.is_active ? 'btn-outline-danger' : 'btn-outline-success' %>">
                                                    <%= s.is_active ? 'Deactivate' : 'Activate' %>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Add Session Modal -->
        <div class="modal fade" id="addSessionModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Create New Session</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="/admin/sessions" method="POST">
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Session Name (e.g. 2026-27)</label>
                                <input type="text" name="session_name" class="form-control" required>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Start Date</label>
                                    <input type="date" name="start_date" class="form-control" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">End Date</label>
                                    <input type="date" name="end_date" class="form-control" required>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save Session</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>