<%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="mb-0 fw-bold">College Overview</h3>
                <small class="text-muted">Live statistics and financial health</small>
            </div>
            <div>
                <span class="badge bg-primary fs-6"><i class="bi bi-calendar3"></i>
                    <%= new Date().toLocaleDateString('en-IN', { weekday: 'long' , year: 'numeric' , month: 'short' ,
                        day: 'numeric' }) %>
                </span>
            </div>
        </div>

        <!-- Key Metrics Row -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm border-start border-primary border-4 h-100">
                    <div class="card-body">
                        <div class="text-muted text-uppercase fw-bold" style="font-size: 0.8rem;">Active Students</div>
                        <h2 class="mb-0 mt-2 text-dark"><i class="bi bi-people text-primary me-2"></i>
                            <%= stats.totalStudents %>
                        </h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm border-start border-info border-4 h-100">
                    <div class="card-body">
                        <div class="text-muted text-uppercase fw-bold" style="font-size: 0.8rem;">Active Staff</div>
                        <h2 class="mb-0 mt-2 text-dark"><i class="bi bi-person-workspace text-info me-2"></i>
                            <%= stats.totalTeachers %>
                        </h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm border-start border-success border-4 h-100">
                    <div class="card-body">
                        <div class="text-muted text-uppercase fw-bold" style="font-size: 0.8rem;">Present Today</div>
                        <h2 class="mb-0 mt-2 text-dark"><i class="bi bi-check2-circle text-success me-2"></i>
                            <%= stats.presentToday %>
                        </h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm border-start border-warning border-4 h-100">
                    <div class="card-body">
                        <div class="text-muted text-uppercase fw-bold" style="font-size: 0.8rem;">Results Published
                        </div>
                        <h2 class="mb-0 mt-2 text-dark"><i class="bi bi-award text-warning me-2"></i>
                            <%= stats.resultsPublished %>
                        </h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Financial Health Row -->
        <div class="row">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-success text-white h-100"
                    style="background-image: linear-gradient(45deg, #198754, #20c997);">
                    <div class="card-body p-4">
                        <h6 class="text-uppercase fw-bold opacity-75">Total Revenue (Fees + Income)</h6>
                        <h1 class="display-6 fw-bold mt-3">₹ <%= stats.totalIncome.toLocaleString('en-IN') %>
                        </h1>
                        <a href="/admin/accounts" class="text-white text-decoration-none small"><i
                                class="bi bi-arrow-right-circle"></i> View Ledger</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-danger text-white h-100"
                    style="background-image: linear-gradient(45deg, #dc3545, #f87171);">
                    <div class="card-body p-4">
                        <h6 class="text-uppercase fw-bold opacity-75">Total Expenses</h6>
                        <h1 class="display-6 fw-bold mt-3">₹ <%= stats.totalExpense.toLocaleString('en-IN') %>
                        </h1>
                        <a href="/admin/accounts" class="text-white text-decoration-none small"><i
                                class="bi bi-arrow-right-circle"></i> View Ledger</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-dark text-white h-100">
                    <div class="card-body p-4">
                        <h6 class="text-uppercase fw-bold text-secondary">Current Balance</h6>
                        <h1 class="display-6 fw-bold mt-3 text-<%= stats.currentBalance >= 0 ? 'success' : 'danger' %>">
                            ₹ <%= stats.currentBalance.toLocaleString('en-IN') %>
                        </h1>
                        <p class="small text-secondary mt-2 mb-0">Total Revenue minus Total Expenses</p>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>