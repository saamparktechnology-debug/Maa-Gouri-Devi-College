<%- include('../partials/header') %>
    <div class="container mt-5" style="max-width: 400px;">
        <div class="card shadow-sm border-0 p-4">
            <h4 class="fw-bold mb-3">Verify OTP</h4>
            <p class="text-muted small">Enter the 6-digit verification code sent to your email.</p>
            <% if (error) { %>
                <div class="alert alert-danger py-2">
                    <%= error %>
                </div>
                <% } %>
                    <form action="/admin/verify-otp" method="POST">
                        <div class="mb-3">
                            <input type="text" name="otp" class="form-control text-center fs-4 tracking-widest"
                                maxlength="6" required autofocus>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Verify & Login</button>
                    </form>
        </div>
    </div>
    <%- include('../partials/footer') %>