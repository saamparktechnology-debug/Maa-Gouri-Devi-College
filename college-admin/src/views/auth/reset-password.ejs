<%- include('../partials/header') %>

    <div class="container-fluid vh-100 d-flex align-items-center justify-content-center bg-light">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden" style="max-width: 900px; width: 100%;">
            <div class="row g-0">
                <!-- Left Branding Side -->
                <div class="col-md-6 bg-primary text-white d-flex flex-column justify-content-center p-5">
                    <div class="mb-3">
                        <i class="bi bi-shield-lock-fill display-4"></i>
                    </div>
                    <h3 class="fw-bold mb-2">Secure Your Account</h3>
                    <p class="text-white-50 mb-0">Enter the 6-digit OTP sent to your registered email address along with
                        a secure new password.</p>
                </div>

                <!-- Right Form Side -->
                <div class="col-md-6 bg-white p-5 d-flex flex-column justify-content-center">
                    <div class="text-center mb-4">
                        <h4 class="fw-bold text-dark">Set New Password</h4>
                        <p class="text-muted small">Choose a strong password you haven't used before.</p>
                    </div>

                    <% if (typeof error !=='undefined' && error) { %>
                        <div class="alert alert-danger py-2 small mb-3">
                            <i class="bi bi-exclamation-circle-fill me-1"></i>
                            <%= error %>
                        </div>
                        <% } %>

                            <form action="/admin/reset-password" method="POST">
                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-secondary">OTP Code</label>
                                    <input type="text" name="otp"
                                        class="form-control text-center fs-4 tracking-widest bg-light" maxlength="6"
                                        placeholder="------" required autofocus>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold small text-secondary">New Password</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i
                                                class="bi bi-key"></i></span>
                                        <input type="password" name="new_password"
                                            class="form-control bg-light border-start-0"
                                            placeholder="Enter new password" required>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                                    <i class="bi bi-check-circle me-1"></i> Update Password
                                </button>
                            </form>

                            <div class="text-center mt-4">
                                <a href="/admin/login" class="text-decoration-none small text-muted">
                                    <i class="bi bi-arrow-left"></i> Back to Login
                                </a>
                            </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>