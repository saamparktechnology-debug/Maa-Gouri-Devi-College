<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify OTP - MGD College</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body,
        html {
            height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background-color: #f8fafc;
        }

        .split-container {
            display: flex;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
        }

        .left-pane {
            flex: 1;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
            box-shadow: 10px 0 30px rgba(0, 0, 0, 0.05);
            z-index: 2;
        }

        .right-pane {
            flex: 1;
            background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
            color: #0369a1;
            text-align: center;
        }

        .form-card {
            width: 100%;
            max-width: 380px;
        }

        .btn-custom {
            background-color: #0891b2;
            border: none;
            color: white;
            font-weight: 600;
            padding: 10px;
            transition: background 0.2s;
        }

        .btn-custom:hover {
            background-color: #0e7490;
            color: white;
        }

        @media (max-width: 768px) {
            .right-pane {
                display: none;
            }

            .left-pane {
                flex: 1;
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <div class="split-container">
        <div class="left-pane">
            <div class="form-card">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-dark mb-1">SECURITY CHECK</h3>
                    <p class="text-muted small">Enter the 6-digit OTP sent to your email.</p>
                </div>

                <% if (typeof error !=='undefined' && error) { %>
                    <div class="alert alert-danger py-2 small text-center">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/admin/verify-otp" method="POST">
                            <div class="mb-4">
                                <input type="text" name="otp"
                                    class="form-control text-center fs-3 tracking-widest bg-light fw-bold" maxlength="6"
                                    placeholder="------" required autofocus>
                            </div>
                            <button type="submit" class="btn btn-custom w-100 rounded-pill shadow-sm">Verify &
                                Proceed</button>
                        </form>
                        <div class="text-center mt-3">
                            <a href="/admin/login" class="text-muted small text-decoration-none"><i
                                    class="bi bi-arrow-left"></i> Back to Login</a>
                        </div>
            </div>
        </div>

        <div class="right-pane">
            <div class="mb-3">
                <i class="bi bi-shield-lock-fill text-info" style="font-size: 5rem;"></i>
            </div>
            <h2 class="fw-bold text-dark">Two-Factor Authentication</h2>
            <p class="text-secondary small mt-2" style="max-width: 320px;">Your security is our top priority. Please
                confirm your identity to enter the admin portal.</p>
        </div>
    </div>

</body>

</html>