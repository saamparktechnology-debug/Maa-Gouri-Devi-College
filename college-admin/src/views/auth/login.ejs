<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - MGD College</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body,
        html {
            height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8fafc;
        }

        .split-container {
            display: flex;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
        }

        .left-pane {
            flex: 1;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
            box-shadow: 10px 0 30px rgba(0, 0, 0, 0.05);
            z-index: 2;
        }

        .right-pane {
            flex: 1;
            background: linear-gradient(135deg, #0b2454 0%, #173b82 100%);
            /* Adjusted to complement the Navy/Gold logo */
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
            color: #ffffff;
            text-align: center;
        }

        .form-card {
            width: 100%;
            max-width: 380px;
        }

        .btn-custom {
            background-color: #c99332;
            /* Matched to Logo Gold */
            border: none;
            color: white;
            font-weight: 600;
            padding: 10px;
            transition: background 0.2s;
        }

        .btn-custom:hover {
            background-color: #a87826;
            color: white;
        }

        .college-logo-img {
            width: 90px;
            height: 90px;
            object-fit: contain;
            margin-bottom: 15px;
        }

        @media (max-width: 768px) {
            .right-pane {
                display: none;
            }

            .left-pane {
                flex: 1;
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <div class="split-container">
        <!-- Left Pane: Form -->
        <div class="left-pane">
            <div class="form-card">
                <div class="text-center mb-4">
                    <img src="/admin/assets/logo/logo_icon.png" alt="Maa Gouri Devi College Logo"
                        class="college-logo-img">
                    <h3 class="fw-bold text-dark mb-1">Maa Gouri Devi College</h3>
                    <p class="text-muted small">Administration Portal</p>
                </div>

                <% if (typeof error !=='undefined' && error) { %>
                    <div class="alert alert-danger py-2 small text-center">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/admin/login" method="POST">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-secondary">Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i
                                            class="bi bi-envelope text-muted"></i></span>
                                    <input type="email" name="email" class="form-control bg-light border-start-0"
                                        placeholder="admin@mgdcollege.com" required autofocus>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-secondary">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i
                                            class="bi bi-lock text-muted"></i></span>
                                    <input type="password" name="password" class="form-control bg-light border-start-0"
                                        placeholder="••••••••" required>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4 small">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="remember">
                                    <label class="form-check-label text-muted" for="remember">Remember me</label>
                                </div>
                                <a href="/admin/forgot-password" class="text-decoration-none fw-semibold"
                                    style="color: #c99332;">Forgot Password?</a>
                            </div>

                            <button type="submit" class="btn btn-custom w-100 rounded-pill shadow-sm">Login to
                                Dashboard</button>
                        </form>
            </div>
        </div>

        <!-- Right Pane: Illustration / Branding Graphic -->
        <div class="right-pane">
            <div class="mb-4">
                <img src="/admin/assets/logo/logo.png" alt="MGD College Emblem"
                    style="width: 220px; height: auto; filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.3));">
            </div>
            <h2 class="fw-bold text-white mb-2">College Management System</h2>
            <p class="text-light small mt-2 opacity-75" style="max-width: 320px;">Streamlining academics, fee
                structures, staff
                payroll, and student attendance securely.</p>
        </div>
    </div>

</body>

</html>