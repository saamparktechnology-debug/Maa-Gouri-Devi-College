<style>
    /* ================================
        SIDEBAR
    ================================ */
    .sidebar {
        width: 260px;
        height: 100vh;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;

        background: #111827 !important;
        border-right: 1px solid #1f2937 !important;
    }

    /* ================================
        FIXED BRAND / HEADER
    ================================ */
    .sidebar-brand {
        width: 100%;
        padding: 10px 0px !important;
        background: #111827 !important;
        border-bottom: 1px solid #1f2937 !important;
    }

    .sidebar-brand-inner {
        width: 100%;
    }

    .sidebar-brand-text {
        width: 100%;
        background: #111827 !important;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .sidebar-logo {
        width: 205px;
        height: 55px;
        object-fit: contain;
        display: block;
    }

    .sidebar-brand-title {
        color: #fff;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
    }

    .brand-subtitle {
        display: block;
        color: #6b7280;
        font-size: 10px;
        font-weight: 400;
        margin-top: 3px;
        white-space: nowrap;
    }

    /* ================================
        SCROLLABLE MENU AREA
    ================================ */
    .sidebar-menu {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding-bottom: 15px;
    }

    .sidebar-menu::-webkit-scrollbar {
        width: 5px;
    }

    .sidebar-menu::-webkit-scrollbar-track {
        background: transparent;
    }

    .sidebar-menu::-webkit-scrollbar-thumb {
        background: #374151;
        border-radius: 10px;
    }

    .sidebar-menu:hover::-webkit-scrollbar-thumb {
        background: #4b5563;
    }

    /* Firefox */
    .sidebar-menu {
        scrollbar-width: thin;
        scrollbar-color: #374151 transparent;
    }

    /* ================================
        SECTION TITLES
    ================================ */
    .sidebar-section-title {
        color: #6b7280;
        font-size: 10px;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 1px;
        padding: 18px 18px 7px;
    }

    /* ================================
        MENU LINKS
    ================================ */
    .sidebar-menu-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 15px;
        margin: 2px 10px;
        color: #cbd5e1;
        text-decoration: none;
        border-radius: 7px;
        font-size: 13px;
        transition: all 0.2s ease;
    }

    .sidebar-menu-link i {
        width: 20px;
        text-align: center;
        font-size: 15px;
        color: #94a3b8;
        flex-shrink: 0;
    }

    .sidebar-menu-link:hover {
        background: #1e293b;
        color: #fff;
    }

    .sidebar-menu-link:hover i {
        color: #60a5fa;
    }

    .sidebar-menu-link.active {
        background: #2563eb;
        color: #fff;
        box-shadow: 0 3px 10px rgba(37, 99, 235, 0.25);
    }

    .sidebar-menu-link.active i {
        color: #fff;
    }

    /* ================================
        FIXED LOGOUT
    ================================ */
    .sidebar-logout {
        flex-shrink: 0;
        padding: 12px 10px 15px;
        border-top: 1px solid #1f2937;
        background: #111827;
    }

    .sidebar-logout .btn {
        border-color: #374151;
        color: #f87171;
    }

    .sidebar-logout .btn:hover {
        background: #dc2626;
        border-color: #dc2626;
        color: #fff;
    }

    /* ================================
        MAIN CONTENT
    ================================ */
    .main-content {
        min-width: 0;
    }

    /* ================================
        MOBILE
    ================================ */
    @media (max-width: 767.98px) {
        .sidebar {
            position: fixed;
            left: -270px;
            top: 0;
            z-index: 1050;
            transition: left 0.25s ease;
            box-shadow: 5px 0 20px rgba(0, 0, 0, 0.2);
        }

        .sidebar.show {
            left: 0;
        }

        .main-content {
            width: 100%;
        }
    }
</style>


