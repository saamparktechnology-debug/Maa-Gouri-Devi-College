        <script>
            document.addEventListener('DOMContentLoaded', function () {

                // Get current URL path
                const currentPath = window.location.pathname
                    .replace(/\/+$/, '') || '/';

                // Get all sidebar links
                const sidebarLinks = document.querySelectorAll(
                    '.sidebar-menu a.sidebar-menu-link, .sidebar-menu a.list-group-item'
                );

                let exactMatch = null;

                // First remove any existing active class
                sidebarLinks.forEach(function (link) {
                    link.classList.remove('active');

                    const linkPath = new URL(link.href, window.location.origin)
                        .pathname
                        .replace(/\/+$/, '') || '/';

                    // Exact URL match
                    if (linkPath === currentPath && !exactMatch) {
                        exactMatch = link;
                    }
                });

                // Highlight only the matching/current tab
                if (exactMatch) {
                    exactMatch.classList.add('active');

                    // Scroll active menu item into view if needed
                    const sidebarMenu = document.querySelector('.sidebar-menu');

                    if (sidebarMenu) {
                        const menuTop = sidebarMenu.getBoundingClientRect().top;
                        const menuBottom = sidebarMenu.getBoundingClientRect().bottom;

                        const linkTop = exactMatch.getBoundingClientRect().top;
                        const linkBottom = exactMatch.getBoundingClientRect().bottom;

                        if (linkTop < menuTop || linkBottom > menuBottom) {
                            exactMatch.scrollIntoView({
                                block: 'nearest',
                                behavior: 'smooth'
                            });
                        }
                    }
                }

            });
        </script>