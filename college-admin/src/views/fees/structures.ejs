<%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0">Fee Structures Master</h4>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addFeeModal">
                <i class="bi bi-plus-circle"></i> Define New Fee
            </button>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">

                <!-- THE UPGRADE: 4-Part Real-time Filters -->
                <div class="row mb-4">
                    <div class="col-md-3 mb-2">
                        <input type="text" id="searchInput" class="form-control"
                            placeholder="🔍 Search fee type, amount...">
                    </div>
                    <div class="col-md-3 mb-2">
                        <select id="filterCourse" class="form-select">
                            <option value="">All Courses</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-2">
                        <select id="filterSession" class="form-select">
                            <option value="">All Sessions</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-2">
                        <select id="filterSemester" class="form-select">
                            <option value="">All Semesters</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="feeStructureTable">
                        <thead class="table-light">
                            <tr>
                                <th>Type</th>
                                <th>Course</th>
                                <th>Session</th>
                                <th>Semester</th>
                                <th>Amount (₹)</th>
                                <th>Due Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (structures.length===0) { %>
                                <tr>
                                    <td colspan="6" class="text-center text-muted">No fee structures defined yet.</td>
                                </tr>
                                <% } %>
                                    <% structures.forEach(f=> { %>
                                        <tr>
                                            <td class="fw-bold text-primary">
                                                <%= f.FeeType ? f.FeeType.name : 'N/A' %>
                                            </td>
                                            <td>
                                                <%= f.Course ? f.Course.course_name : 'N/A' %>
                                            </td>
                                            <td>
                                                <%= f.AcademicSession ? f.AcademicSession.session_name : 'N/A' %>
                                            </td>
                                            <td>
                                                <%= f.Semester ? f.Semester.semester_name : 'N/A' %>
                                            </td>
                                            <td class="fw-bold text-success">₹<%= parseFloat(f.amount).toFixed(2) %>
                                            </td>
                                            <td>
                                                <%= f.due_date ? f.due_date : 'N/A' %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <tr id="noResultsRow" style="display: none;">
                                                <td colspan="6" class="text-center text-muted py-4">No fee structures
                                                    match your filters.</td>
                                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Add Fee Structure Modal -->
        <div class="modal fade" id="addFeeModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <form action="/admin/fees/structures" method="POST">
                        <div class="modal-header">
                            <h5 class="modal-title">Define Fee Structure</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Fee Type</label>
                                    <select name="fee_type_id" class="form-select" required>
                                        <option value="">Select...</option>
                                        <% types.forEach(ft=> { %>
                                            <option value="<%= ft.id %>">
                                                <%= ft.name %>
                                            </option>
                                            <% }) %>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Session</label>
                                    <select name="session_id" class="form-select" required>
                                        <option value="">Select...</option>
                                        <% sessions.forEach(s=> { %>
                                            <option value="<%= s.id %>">
                                                <%= s.session_name %>
                                            </option>
                                            <% }) %>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Course</label>
                                    <select name="course_id" id="courseSelect" class="form-select" required
                                        onchange="filterSemesters()">
                                        <option value="">Select...</option>
                                        <% courses.forEach(c=> { %>
                                            <option value="<%= c.id %>">
                                                <%= c.course_name %>
                                            </option>
                                            <% }) %>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Semester</label>
                                    <select name="semester_id" id="semesterSelect" class="form-select" required>
                                        <option value="">Select...</option>
                                        <% semesters.forEach(s=> { %>
                                            <option value="<%= s.id %>" data-course="<%= s.course_id %>">
                                                <%= s.semester_name %>
                                            </option>
                                            <% }) %>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Amount (₹)</label>
                                    <input type="number" step="0.01" name="amount" class="form-control" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Due Date (Optional)</label>
                                    <input type="date" name="due_date" class="form-control">
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="submit" class="btn btn-primary">Save Fee Structure</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            // Modal Cascading Dropdown
            function filterSemesters() {
                const courseId = document.getElementById('courseSelect').value;
                const semSelect = document.getElementById('semesterSelect');
                const options = semSelect.querySelectorAll('option');
                semSelect.value = '';
                options.forEach(opt => {
                    if (opt.value === "") return;
                    if (opt.getAttribute('data-course') === courseId) { opt.style.display = 'block'; }
                    else { opt.style.display = 'none'; }
                });
            }

            // Real-Time Filter Engine
            document.addEventListener("DOMContentLoaded", () => {
                const searchInput = document.getElementById("searchInput");
                const filterCourse = document.getElementById("filterCourse");
                const filterSession = document.getElementById("filterSession");
                const filterSemester = document.getElementById("filterSemester");
                const tableRows = document.querySelectorAll("#feeStructureTable tbody tr:not(#noResultsRow)");
                const noResultsRow = document.getElementById("noResultsRow");

                // 1. Auto-Populate Dropdowns
                const uniqueCourses = new Set();
                const uniqueSessions = new Set();
                const uniqueSemesters = new Set();

                tableRows.forEach(row => {
                    if (row.cells.length < 6) return;
                    const courseText = row.cells[1].innerText.trim();
                    const sessionText = row.cells[2].innerText.trim();
                    const semesterText = row.cells[3].innerText.trim();

                    if (courseText && courseText !== 'N/A') uniqueCourses.add(courseText);
                    if (sessionText && sessionText !== 'N/A') uniqueSessions.add(sessionText);
                    if (semesterText && semesterText !== 'N/A') uniqueSemesters.add(semesterText);
                });

                uniqueCourses.forEach(c => filterCourse.add(new Option(c, c.toLowerCase())));
                uniqueSessions.forEach(s => filterSession.add(new Option(s, s.toLowerCase())));
                uniqueSemesters.forEach(s => filterSemester.add(new Option(s, s.toLowerCase())));

                // 2. Filter Logic
                function filterTable() {
                    const query = searchInput.value.toLowerCase().trim();
                    const course = filterCourse.value.toLowerCase().trim();
                    const session = filterSession.value.toLowerCase().trim();
                    const semester = filterSemester.value.toLowerCase().trim();

                    let visibleCount = 0;

                    tableRows.forEach(row => {
                        if (row.cells.length < 6) return;

                        const rowText = row.innerText.toLowerCase();
                        const rowCourse = row.cells[1].innerText.toLowerCase().trim();
                        const rowSession = row.cells[2].innerText.toLowerCase().trim();
                        const rowSemester = row.cells[3].innerText.toLowerCase().trim();

                        const matchesSearch = query === "" || rowText.includes(query);
                        const matchesCourse = course === "" || rowCourse === course;
                        const matchesSession = session === "" || rowSession === session;
                        const matchesSemester = semester === "" || rowSemester === semester;

                        if (matchesSearch && matchesCourse && matchesSession && matchesSemester) {
                            row.style.display = "";
                            visibleCount++;
                        } else {
                            row.style.display = "none";
                        }
                    });

                    if (noResultsRow) {
                        noResultsRow.style.display = visibleCount === 0 ? "" : "none";
                    }
                }

                searchInput.addEventListener("keyup", filterTable);
                filterCourse.addEventListener("change", filterTable);
                filterSession.addEventListener("change", filterTable);
                filterSemester.addEventListener("change", filterTable);
            });
        </script>

        <%- include('../partials/footer') %>