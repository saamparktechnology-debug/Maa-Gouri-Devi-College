<%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0">Fee Collection: <%= student.first_name %>
                    <%= student.last_name %>
            </h4>
            <a href="/admin/fees/collection" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to
                List</a>
        </div>

        <!-- Student Info Card -->
        <div class="card border-0 shadow-sm mb-4 bg-light">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3"><strong>Admission No:</strong>
                        <%= student.admission_no %>
                    </div>
                    <div class="col-md-3"><strong>Course:</strong>
                        <%= student.Course ? student.Course.course_name : 'N/A' %>
                    </div>
                    <div class="col-md-3"><strong>Session:</strong>
                        <%= student.AcademicSession ? student.AcademicSession.session_name : 'N/A' %>
                    </div>
                    <div class="col-md-3"><strong>Semester:</strong>
                        <%= student.Semester ? student.Semester.semester_name : 'N/A' %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Academic Fees Section -->
        <h5 class="mb-3 text-primary">Academic Fees</h5>
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Fee Type</th>
                            <th>Total Amount</th>
                            <th>Paid Amount</th>
                            <!-- NEW: Waived Column -->
                            <th>Waived Amount</th>
                            <th>Due Amount</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (feesData.length===0) { %>
                            <tr>
                                <!-- Updated colspan to 7 -->
                                <td colspan="7" class="text-center text-muted py-3">No fee structures found for this
                                    student's current enrollment.</td>
                            </tr>
                            <% } else { %>
                                <% feesData.forEach(fee=> { %>
                                    <tr>
                                        <td class="ps-3 fw-bold">
                                            <%= fee.structure.FeeType ? fee.structure.FeeType.name : 'Unknown' %>
                                        </td>
                                        <td>₹<%= parseFloat(fee.structure.amount).toFixed(2) %>
                                        </td>
                                        <td class="text-success">₹<%= fee.totalPaid.toFixed(2) %>
                                        </td>

                                        <!-- NEW: Displaying Waived Amount -->
                                        <td class="text-warning text-dark fw-bold">
                                            ₹<%= fee.totalWaived.toFixed(2) %>
                                        </td>

                                        <td class="text-danger fw-bold">₹<%= fee.due.toFixed(2) %>
                                        </td>
                                        <td>
                                            <% if (fee.status==='Paid' ) { %>
                                                <span class="badge bg-success">Paid</span>
                                                <% } else if (fee.status==='Partial' ) { %>
                                                    <span class="badge bg-warning text-dark">Partial</span>
                                                    <% } else { %>
                                                        <span class="badge bg-danger">Pending</span>
                                                        <% } %>
                                        </td>
                                        <td class="text-end pe-3">
                                            <% if (fee.due> 0) { %>
                                                <button class="btn btn-sm btn-primary" data-bs-toggle="modal"
                                                    data-bs-target="#payFeeModal<%= fee.structure.id %>">Collect</button>

                                                <button type="button" class="btn btn-sm btn-warning fw-bold shadow-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#waiverModal<%= fee.structure.id %>">
                                                    <i class="bi bi-shield-check"></i> Waive
                                                </button>
                                                <% } else { %>
                                                    <button class="btn btn-sm btn-outline-success" disabled><i
                                                            class="bi bi-check-circle"></i> Cleared</button>
                                                    <% } %>

                                                        <!-- NEW: Print Receipt Button (Shows if any payment has been made) -->
                                                        <% if (fee.totalPaid> 0 && fee.latestPaymentId) { %>
                                                            <a href="/admin/fees/receipt/<%= fee.latestPaymentId %>"
                                                                target="_blank"
                                                                class="btn btn-sm btn-outline-secondary ms-1"
                                                                title="Print Fee Receipt">
                                                                <i class="bi bi-printer"></i> Receipt
                                                            </a>
                                                            <% } %>
                                        </td>
                                    </tr>

                                    <!-- Modal for Collecting Payment -->
                                    <% if (fee.due> 0) { %>
                                        <div class="modal fade" id="payFeeModal<%= fee.structure.id %>" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form action="/admin/fees/payments/pay" method="POST">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Collect <%= fee.structure.FeeType ?
                                                                    fee.structure.FeeType.name : 'Fee' %>
                                                            </h5>
                                                            <button type="button" class="btn-close"
                                                                data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <input type="hidden" name="student_id"
                                                                value="<%= student.id %>">
                                                            <input type="hidden" name="fee_structure_id"
                                                                value="<%= fee.structure.id %>">

                                                            <div class="alert alert-info">
                                                                <strong>Amount Due: </strong> ₹<%= fee.due.toFixed(2) %>
                                                            </div>

                                                            <div class="mb-3">
                                                                <label class="form-label">Paying Amount (₹)</label>
                                                                <input type="number" step="0.01" name="amount_paid"
                                                                    class="form-control" max="<%= fee.due %>" required>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label">Payment Method</label>
                                                                <select name="payment_method" class="form-select"
                                                                    required>
                                                                    <option value="Cash">Cash</option>
                                                                    <option value="UPI">UPI</option>
                                                                    <option value="Bank Transfer">Bank Transfer</option>
                                                                    <option value="Cheque">Cheque</option>
                                                                </select>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label">Reference No
                                                                    (Optional)</label>
                                                                <input type="text" name="reference_no"
                                                                    class="form-control"
                                                                    placeholder="Txn ID / Cheque No">
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label">Payment Date</label>
                                                                <input type="date" name="payment_date"
                                                                    class="form-control"
                                                                    value="<%= new Date().toISOString().split('T')[0] %>"
                                                                    required>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer bg-light">
                                                            <button type="submit" class="btn btn-primary">Process
                                                                Payment</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- ROW-SPECIFIC Waiver Modal -->
                                        <div class="modal fade" id="waiverModal<%= fee.structure.id %>" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content border-0 shadow">
                                                    <form action="/admin/fees/waiver" method="POST">
                                                        <input type="hidden" name="student_id"
                                                            value="<%= student.id %>">
                                                        <input type="hidden" name="fee_structure_id"
                                                            value="<%= fee.structure.id %>">

                                                        <div class="modal-header bg-warning text-dark">
                                                            <h5 class="modal-title fw-bold"><i
                                                                    class="bi bi-shield-check"></i> Grant Fee Waiver
                                                            </h5>
                                                            <button type="button" class="btn-close"
                                                                data-bs-dismiss="modal"></button>
                                                        </div>

                                                        <div class="modal-body">
                                                            <div class="alert alert-warning mb-3">
                                                                <strong>Waiving:</strong>
                                                                <%= fee.structure.FeeType ? fee.structure.FeeType.name
                                                                    : 'Fee' %><br>
                                                                    <strong>Current Due:</strong> ₹<%=
                                                                        fee.due.toFixed(2) %>
                                                            </div>

                                                            <div class="mb-3">
                                                                <label class="form-label">Waiver Amount (₹)</label>
                                                                <input type="number" step="0.01" name="waiver_amount"
                                                                    class="form-control" placeholder="e.g., 5000"
                                                                    max="<%= fee.due %>" required>
                                                            </div>

                                                            <div class="mb-3">
                                                                <label class="form-label">Reason / Authorization</label>
                                                                <input type="text" name="reason" class="form-control"
                                                                    placeholder="e.g., Merit Scholarship / Staff Ward"
                                                                    required>
                                                            </div>

                                                            <div class="alert alert-info py-2 mb-0"
                                                                style="font-size: 0.85rem;">
                                                                <i class="bi bi-info-circle me-1"></i> This action will
                                                                be logged under your Admin ID for audit purposes.
                                                            </div>
                                                        </div>

                                                        <div class="modal-footer bg-light">
                                                            <button type="button" class="btn btn-outline-secondary"
                                                                data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-warning fw-bold">Apply
                                                                Concession</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                        <% } %>
                                            <% }) %>
                                                <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Apply Fee Waiver Modal -->
        <div class="modal fade" id="waiverModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content border-0 shadow">
                    <form action="/admin/fees/waiver" method="POST">
                        <!-- Pass the specific student ID -->
                        <input type="hidden" name="student_id" value="<%= student.id %>">

                        <div class="modal-header bg-warning text-dark">
                            <h5 class="modal-title fw-bold"><i class="bi bi-shield-check"></i> Grant Fee Waiver</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Select Fee to Waive</label>
                                <select name="fee_structure_id" class="form-select" required>
                                    <option value="">Choose Pending Fee...</option>
                                    <!-- Assuming you pass 'pendingFees' to this view in your controller -->
                                    <% if (typeof pendingFees !=='undefined' ) { %>
                                        <% pendingFees.forEach(fee=> { %>
                                            <option value="<%= fee.id %>">
                                                <%= fee.FeeType.name %> (₹<%= parseFloat(fee.amount).toFixed(2) %>)
                                            </option>
                                            <% }) %>
                                                <% } %>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Waiver Amount (₹)</label>
                                <input type="number" step="0.01" name="waiver_amount" class="form-control"
                                    placeholder="e.g., 5000" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Reason / Authorization</label>
                                <input type="text" name="reason" class="form-control"
                                    placeholder="e.g., Merit Scholarship / Staff Ward" required>
                            </div>

                            <div class="alert alert-info py-2 mb-0" style="font-size: 0.85rem;">
                                <i class="bi bi-info-circle me-1"></i> This action will be logged under your Admin ID
                                for audit purposes.
                            </div>
                        </div>

                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-warning fw-bold">Apply Concession</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>