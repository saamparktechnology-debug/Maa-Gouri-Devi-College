<%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0">Student Profile</h4>
            <div>
                <a href="/admin/students/<%= student.id %>/edit" class="btn btn-warning me-2"><i
                        class="bi bi-pencil"></i> Edit</a>
                <a href="/admin/students" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
            </div>
        </div>

        <div class="row">
            <!-- Academic Info -->
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white fw-bold text-primary">
                        <i class="bi bi-journal-text me-2"></i> Academic Info
                    </div>
                    <div class="card-body">
                        <p><strong>Admission No:</strong>
                            <%= student.admission_no %>
                        </p>
                        <p><strong>Roll No:</strong>
                            <%= student.roll_no || 'N/A' %>
                        </p>
                        <p><strong>Course:</strong>
                            <%= student.Course ? student.Course.course_name : 'N/A' %>
                        </p>
                        <p><strong>Session:</strong>
                            <%= student.AcademicSession ? student.AcademicSession.session_name : 'N/A' %>
                        </p>
                        <p><strong>Semester:</strong>
                            <%= student.Semester ? student.Semester.semester_name : 'N/A' %>
                        </p>
                        <p>
                            <strong>Status:</strong>
                            <span
                                class="badge <%= student.status === 'Active' ? 'bg-success' : (student.status === 'Alumni' ? 'bg-info' : 'bg-secondary') %>">
                                <%= student.status %>
                            </span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Personal Info -->
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white fw-bold text-primary">
                        <i class="bi bi-person me-2"></i> Personal Info
                    </div>
                    <div class="card-body">
                        <p><strong>Name:</strong>
                            <%= student.first_name %>
                                <%= student.last_name %>
                        </p>
                        <p><strong>Father:</strong>
                            <%= student.father_name || 'N/A' %>
                        </p>
                        <p><strong>Mother:</strong>
                            <%= student.mother_name || 'N/A' %>
                        </p>
                        <p><strong>DOB:</strong>
                            <%= student.dob %>
                        </p>
                        <p><strong>Gender:</strong>
                            <%= student.gender %>
                        </p>
                        <p><strong>Mobile:</strong>
                            <%= student.mobile || 'N/A' %>
                        </p>
                        <p><strong>Email:</strong>
                            <%= student.email || 'N/A' %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Address & Documents -->
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white fw-bold text-primary">
                        <i class="bi bi-geo-alt me-2"></i> Address
                    </div>
                    <div class="card-body">
                        <p>
                            <%= student.address || 'No address provided' %>
                        </p>
                        <p>
                            <%= student.city %>
                                <%= student.state ? ', ' + student.state : '' %>
                                    <%= student.pincode %>
                        </p>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white fw-bold text-primary">
                        <i class="bi bi-file-earmark me-2"></i> Documents
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            <% if (documents && documents.length> 0) { %>
                                <% documents.forEach(doc=> { %>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <%= doc.document_type %>
                                            <!-- FIX: Changed from link to a button triggering the JS function -->
                                            <button type="button"
                                                onclick="viewDocument('/admin/students/document/<%= doc.id %>', '<%= doc.document_type %>')"
                                                class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i> View
                                            </button>
                                    </li>
                                    <% }) %>
                                        <% } else { %>
                                            <li class="list-group-item text-muted">No documents uploaded</li>
                                            <% } %>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Document Viewer Modal -->
        <div class="modal fade" id="documentModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="documentModalTitle">Document Viewer</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-0" style="height: 80vh;">
                        <!-- Iframe renders PDFs and Images perfectly -->
                        <iframe id="documentFrame" src="" style="width: 100%; height: 100%; border: none;"></iframe>
                    </div>
                </div>
            </div>
        </div>

        <!-- JavaScript to load document into Modal -->
        <script>
            function viewDocument(docUrl, docTitle) {
                // 1. Set the Title
                document.getElementById('documentModalTitle').innerText = docTitle;
                // 2. Load the URL into the iframe
                document.getElementById('documentFrame').src = docUrl;
                // 3. Show the modal
                var myModal = new bootstrap.Modal(document.getElementById('documentModal'));
                myModal.show();
            }
        </script>

        <%- include('../partials/footer') %>